# Azure 인증 정보
subscription_id = "your-azure-subscription-id"
tenant_id       = "your-azure-tenant-id"

# 1-always에서 생성된 리소스 참조
resource_group_name  = "rg-dr-prod"
vnet_name           = "vnet-dr-prod"
storage_account_name = "drbackupprod2024"  # 1-always와 동일

# MySQL 설정
db_password = "your-secure-mysql-password"  # 강력한 비밀번호 설정

# 환경 설정 (선택사항)
environment = "prod"

# MySQL 설정 (선택사항 - 기본값 사용 가능)
# db_username     = "mysqladmin"
# mysql_sku       = "B_Standard_B2s"
# mysql_storage_gb = 20

# AKS 설정 (선택사항 - 기본값 사용 가능)
# kubernetes_version = null # 또는 해당 리전에서 지원하는 버전
# web_node_count     = 2
# web_node_min_count = 2
# web_node_max_count = 5
# was_node_count     = 2
# was_node_min_count = 2
# was_node_max_count = 5
# node_vm_size       = "Standard_D2s_v3"

# 최초 배포 후 scripts/deploy-complete.sh가 Web LB 주소를 저장하고 적용합니다.
backend_ip_addresses = []
backend_port = 80

# DB 복원은 VNet 연결 작업 환경(VPN 또는 내부 runner)에서 실행합니다.
# 일반 인터넷 접속이나 Azure Cloud Shell만으로는 사설 DB에 연결되지 않습니다.

# Tags
tags = {
  Environment = "Production"
  DRPlan      = "Backup-and-Restore"
  Phase       = "Full-Failover"
  ManagedBy   = "Terraform"
}
